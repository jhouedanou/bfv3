# Base Postgres Supabase, via le pooler Supavisor (pas l'hôte direct db.<ref>.supabase.co,
# IPv6 seulement, injoignable depuis Vercel).
# Site et build : mode transaction (port 6543), seul adapté au serverless.
DATABASE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Migrations : mode session (port 5432).
DATABASE_MIGRATE_URL=postgresql://postgres.<ref>:<mot-de-passe>@aws-1-<region>.pooler.supabase.com:5432/postgres
PAYLOAD_SECRET=
# Connexions Postgres par processus (le pooler Supabase en mode session plafonne à 15 au total).
DATABASE_POOL_MAX=5

# URL publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Storage (S3). Laisser S3_BUCKET vide en local pour stocker les images sur disque.
S3_BUCKET=media
S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<region>
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Envoi des e-mails (Resend). Sans clé en local, les e-mails sont écrits dans la console.
RESEND_API_KEY=
MAIL_FROM="BIG FIVE <site@bigfiveabidjan.com>"

# Cloudflare Turnstile. Sans clé en local, la vérification est ignorée.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Cron → /api/payload-jobs/run (publication programmée)
CRON_SECRET=
