# Copier ce fichier en .env pour travailler en local. Ne jamais commiter .env.
# En production, ces variables se renseignent dans Vercel (Settings → Environment Variables).

# ── Nuxt Studio : connexion des éditeurs avec Google ─────────────────────────
# Client OAuth Google (Web application).
# URI de redirection : https://<domaine>/__nuxt_studio/auth/google
STUDIO_GOOGLE_CLIENT_ID=
STUDIO_GOOGLE_CLIENT_SECRET=
# Adresses autorisées, séparées par des virgules, SANS espace.
STUDIO_GOOGLE_MODERATORS=
# Jeton GitHub limité au dépôt (Contents : Read and write). Il enregistre les modifications.
STUDIO_GITHUB_TOKEN=
# Branche où Studio enregistre (lue au build). Par défaut : main.
# STUDIO_BRANCH=main

# ── Nuxt Studio : connexion avec GitHub (facultatif, pour le développeur) ────
# Callback de l'OAuth App : https://<domaine>/__nuxt_studio/auth/github
# STUDIO_GITHUB_CLIENT_ID=
# STUDIO_GITHUB_CLIENT_SECRET=

# ── Formulaires (obligatoires en production) ─────────────────────────────────
NUXT_RESEND_API_KEY=
# Expéditeur : son domaine doit être celui que la clé Resend autorise (bigfive.solutions).
NUXT_MAIL_FROM="BIG FIVE <site@bigfive.solutions>"
# Adresse qui reçoit les demandes (sinon : email de content/reglages.yml).
NUXT_LEADS_TO=
NUXT_TURNSTILE_SECRET_KEY=
NUXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Parutions programmées des baromètres ─────────────────────────────────────
NUXT_VERCEL_DEPLOY_HOOK=
CRON_SECRET=

# ── Site ─────────────────────────────────────────────────────────────────────
NUXT_PUBLIC_SITE_URL=https://bigfive.solutions
# Mesure d'audience. Vides : aucun bandeau cookies, aucun script chargé.
NUXT_PUBLIC_GA_ID=
NUXT_PUBLIC_META_PIXEL_ID=
# Pré-production : garder le site fermé aux moteurs. À retirer au lancement.
# NUXT_INDEXABLE=false
